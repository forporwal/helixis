# Dashboard auth (required — sign-in is disabled if unset)
AUTH_SECRET=generate-with--openssl-rand-base64-32
AUTH_TRUST_HOST=true
HELIXIS_AUTH_EMAIL=admin@helixis.local
HELIXIS_AUTH_PASSWORD=change-me

# Gateway token for the Helixis Claw launch cards. Copy the value from the
# repo-root .env: `next dev` loads this file only, so an unset value here makes
# the cards link with the published dev default `helixis-local` and the Control
# UI answers "unauthorized: gateway token mismatch". Unused in Docker, where
# compose passes the root .env value in directly.
NEMOCLAW_GATEWAY_TOKEN=
