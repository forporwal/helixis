# Real-tier credentials. Copy to a local .env (git-ignored) and fill in.
#
# PLACEHOLDERS ONLY in this file. No real value ever belongs in the repo — the
# loaders in common.py read the environment and have no file-based credential
# path by design. Every variable below is read via require_env(), so a missing
# one aborts the task with a named error rather than silently no-opping into a
# false pass.
#
# Use a DEDICATED test account for each service. These scripts create and delete
# objects for real.

# ---------------------------------------------------------------- Google/Gmail
# OAuth *user* credentials for the dedicated Gmail test mailbox.
# Scopes needed: gmail.compose (create/delete drafts) + gmail.readonly
# (read INBOX/SENT for verification). gmail.send is deliberately NOT requested:
# the task must be unable to send even if the agent tries.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_REFRESH_TOKEN=replace-me
GOOGLE_OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token
GMAIL_TEST_ACCOUNT=helixis-test@example.com

# --------------------------------------------------------------------- Discord
# Webhook posts and deletes the digest (a webhook token may only delete messages
# that same webhook authored). The bot token is read-only here: webhook tokens
# cannot list a channel, so verification needs a bot with View Channel +
# Read Message History on the test channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-me
DISCORD_BOT_TOKEN=replace-me
DISCORD_CHANNEL_ID=000000000000000000

# Slack variant (not wired up): incoming webhooks are write-only, so a Slack
# port needs a bot token with chat:write, channels:history and chat:delete.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/NOW
# SLACK_BOT_TOKEN=xoxb-replace-me
# SLACK_CHANNEL_ID=C00000000

# ---------------------------------------------------------------------- Appify
APIFY_TOKEN=replace-me
APIFY_ACTOR_ID=some-org~some-profile-scraper
APIFY_TARGET_PROFILE_URL=https://example.com/public-profile
# Optional: pin a fixed dataset so the grounding corpus is captured at snapshot
# time instead of being read back from whatever the agent reports.
# APIFY_DATASET_ID=replace-me

# ------------------------------------------------------------------- Harness
# Set by the runner per attempt; only override when invoking verify.py/reset.py
# by hand. Every destructive step is scoped by this id.
# HELIXIS_REAL_RUN_ID=
# Where task output artifacts and run baselines are written.
# HELIXIS_REAL_OUTPUT_DIR=runs/real_tier
