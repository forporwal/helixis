# Helixis configuration. Copy to .env and fill in.
# Nothing here has a working default that costs money — the engine runs in a
# deterministic offline mode until you point it at a real endpoint.

# ---------------------------------------------------------------- agent tier
# The primary task-reasoning model (Nemotron). Provider-agnostic: any
# OpenAI-compatible /v1 endpoint works. Leave the base URL at fake://offline to
# run the simulator instead.
#
#   Featherless: https://api.featherless.ai/v1
#   Fireworks:   https://api.fireworks.ai/inference/v1
#
HELIXIS_AGENT_BASE_URL=fake://offline
HELIXIS_AGENT_MODEL=nvidia/nemotron-4-340b-instruct
HELIXIS_AGENT_API_KEY_VAR=HELIXIS_AGENT_API_KEY
HELIXIS_AGENT_API_KEY=
# Blended pricing per 1M tokens, for the cost meter. Set these to your actual
# rates or the budget cap will not protect you.
HELIXIS_AGENT_INPUT_COST_PER_M=1.0
HELIXIS_AGENT_OUTPUT_COST_PER_M=3.0
HELIXIS_AGENT_CONCURRENCY=4

# ------------------------------------------------------------ distiller tier
# Small Nemotron on vLLM (RunPod, or the local `gpu` compose profile). This tier
# takes the high-volume concurrent calls — distillation, judge votes, triage.
HELIXIS_DISTILLER_BASE_URL=fake://offline
HELIXIS_DISTILLER_MODEL=nvidia/NVIDIA-Nemotron-Nano-9B-v2
HELIXIS_DISTILLER_API_KEY_VAR=HELIXIS_DISTILLER_API_KEY
HELIXIS_DISTILLER_API_KEY=
# Should match vLLM's --max-num-seqs to actually exploit batching.
HELIXIS_DISTILLER_CONCURRENCY=16

# ---------------------------------------------------------------- experiment
HELIXIS_MAX_STEPS=50
HELIXIS_TASK_TIMEOUT_S=900
HELIXIS_MAX_CONCURRENT_TASKS=4
HELIXIS_TOOLSET=api
HELIXIS_TOP_K_SKILLS=4
# keyword (no extra deps) or embedding (needs the `embeddings` extra)
HELIXIS_RETRIEVAL_MODE=keyword

# ------------------------------------------------ real sessions & train cadence
# Real Helixis Claw conversations are captured to runs/claw-sessions by the
# nemoclaw service and turned into tier='real' episodes by `helixis ingest-real`.
# They never enter the headline learning curve (that stays tier='mocked'); they
# feed distillation and the "ready to train" nudge.
#
# How many new real episodes must pile up before Helixis says it is worth
# training. The nudge appears at this number; nothing runs on its own unless
# HELIXIS_AUTO_TRAIN is turned on.
HELIXIS_REAL_TRAIN_THRESHOLD=10
# Off by default: at the threshold you get a nudge, not a run. Set to 1 only if
# you want `helixis ingest-real --watch` to fire train-cycle by itself.
HELIXIS_AUTO_TRAIN=0
# Judge labels below this confidence are excluded from distillation — a 2-of-3
# vote is a coin flip, and teaching from it fills the wiki with noise.
HELIXIS_JUDGE_MIN_CONFIDENCE=0.6
# Seconds a session file must sit untouched before it counts as finished, used
# only when OpenClaw's sessions.json still lists it as active (crashed gateway).
HELIXIS_CLAW_QUIESCENT_AFTER_S=300
# Override where captured sessions are read from (defaults to runs/claw-sessions).
# HELIXIS_CLAW_SESSIONS_DIR=

# --------------------------------------------------------------------- budget
# Hard stops. The runner aborts mid-epoch when either is reached.
HELIXIS_EPOCH_COST_CAP_USD=8.0
HELIXIS_TOTAL_COST_CAP_USD=150.0

# ---------------------------------------------------------------- containment
HELIXIS_OPENSHELL_BIN=openshell
HELIXIS_SANDBOX_NAME=helixis

# ----------------------------------------------------------------- dashboard
HELIXIS_DASHBOARD_PORT=3000
HELIXIS_VLLM_PORT=8000
HUGGING_FACE_HUB_TOKEN=

# Real-tier credentials are documented separately and are NOT loaded here.
# See app/real_tier/.env.example.

# ---------------------------------------------------------------------- auth
#
# The dashboard gates every mutating control (start runs, approve policy
# proposals) behind one operator login. All three of these must be set or the
# dashboard is unusable — and the failure is quiet, so `make preflight` checks
# them.

# The single valid login. Sign-in fails CLOSED if either is unset.
HELIXIS_AUTH_EMAIL=[EMAIL_ADDRESS]
HELIXIS_AUTH_PASSWORD=[PASSWORD]

# Signs the dashboard's session JWTs (compose maps it to AUTH_SECRET).
# WITHOUT IT, /login still returns 200 and only the SUBMIT fails, logging
# `[auth][error] MissingSecret` — i.e. it looks like a wrong password, not a
# missing config value. Generate with `make auth-secret`, or:
#   openssl rand -base64 32
HELIXIS_DASHBOARD_AUTH_SECRET=

# Control UI + browser TUI credential. The Control UI expects it in the URL
# FRAGMENT (http://localhost:18789/#token=...), not as a query parameter; the
# TUI uses it as the basic-auth password for user `helixis`.
#
# Leaving this empty falls back to the published dev default `helixis-local`.
# That is tolerable on a loopback-only laptop and NOT tolerable on a VPS.
# Generate with: openssl rand -hex 24
#
# TWO consumers, and they must agree or the Control UI rejects you with
# "unauthorized: gateway token mismatch" on an otherwise healthy stack:
#   1. claw-init bakes it into the sandbox at create time  -> sandbox recreate
#   2. the dashboard builds the launch-card URL from it    -> dashboard restart
# After changing it: docker compose up -d --force-recreate claw-init dashboard
NEMOCLAW_GATEWAY_TOKEN=

# Absolute HOST path of this repo. claw-init hands it to the gateway as a
# bind-mount source resolved by the HOST daemon, so it cannot be relative.
# Defaults to the compose working directory; deploy/deploy.sh rewrites it to
# the remote path when deploying.
# HELIXIS_ROOT=/opt/helixis

# Set ONLY when exposing the dashboard publicly over TLS
# (deploy/deploy.sh --public). Needs a DNS A record already pointing at the host.
# HELIXIS_PUBLIC_FQDN=helixis.example.com

# NOTE: keep exactly one assignment per variable in this file. Both shell
# sourcing and compose's env_file are LAST-WINS, so a trailing empty duplicate
# silently overrides a filled-in value above it — which for the two auth
# variables means sign-in breaks and the gateway token reverts to the published
# `helixis-local` default, with nothing in any log pointing at the cause.
# `make preflight` catches the symptom; this note is here to prevent the cause.
